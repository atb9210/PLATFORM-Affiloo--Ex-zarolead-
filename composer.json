{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.1.3|^8.0",
        "cloudflare/sdk": "^1.1",
        "daverogers/serverpilot-php": "^1.0",
        "driverfury/cloudflare": "dev-master",
        "driverfury/facebook": "dev-master",
        "driverfury/fraudfilter": "dev-master",
        "driverfury/tiktok": "dev-master",
        "driverfury/worldfilia": "dev-master",
        "driverfury/zarocloner": "dev-master",
        "facebook/graph-sdk": "^5.7",
        "fideloper/proxy": "^4.0",
        "fruitcake/laravel-cors": "^2.0",
        "imtigger/laravel-job-status": "^1.2",
        "laravel/framework": "^7.0",
        "laravel/helpers": "^1.2",
        "laravel/passport": "^9.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.0",
        "league/flysystem-sftp": "~1.0",
        "longman/telegram-bot": "^0.72.0",
        "naturalbuild/namecheap-sdk": "^1.0",
        "smalot/pdfparser": "^0.14.0",
        "spatie/flysystem-dropbox": "^1.2",
        "spatie/ssh": "^1.6"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./packages/driverfury/cloudflare"
        },
        {
            "type": "path",
            "url": "./packages/driverfury/zarocloner"
        },
        {
            "type": "path",
            "url": "./packages/driverfury/fraudfilter"
        },
        {
            "type": "path",
            "url": "./packages/driverfury/worldfilia"
        },
        {
            "type": "path",
            "url": "./packages/driverfury/tiktok"
        },
        {
            "type": "path",
            "url": "./packages/driverfury/facebook"
        }
    ]
}
